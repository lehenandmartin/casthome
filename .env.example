# Everything here is OPTIONAL. CastHome is set up from the browser on first
# use (Navidrome connection, then access), and changed later in Settings.
#
# A Navidrome value set here wins over the one saved from the browser and is
# shown as locked there: useful for scripted or container installs.

# --- Navidrome connection ----------------------------------------------------

# Navidrome URL used by the CastHome backend.
# NAVIDROME_URL=http://192.168.1.10:4533

# Navidrome URL used by the Cast devices to fetch audio and cover art
# (defaults to NAVIDROME_URL). Must be reachable FROM the Chromecast: a LAN IP
# or a name your LAN DNS resolves. Never localhost or a Docker container name.
# Plain HTTP is fine; HTTPS needs a valid (not self-signed) certificate.
# NAVIDROME_PUBLIC_URL_FOR_CAST=http://192.168.1.10:4533

# The Navidrome account CastHome plays with.
# NAVIDROME_USERNAME=me
# NAVIDROME_PASSWORD=

# --- Server --------------------------------------------------------------------

# Encrypts the stored Navidrome password. By default a key is generated into
# <DATA_DIR>/secret.key on first start; keep that file with the database.
# APP_SECRET_KEY=

# DATA_DIR=/data
# PORT=4577
# LOG_LEVEL=INFO

# Set to true when CastHome is served over HTTPS (adds the Secure cookie flag).
# COOKIE_SECURE=false

# Reverse proxies trusted to give the visitor's address (X-Forwarded-For):
# IPs or networks, comma-separated. Needed for "Open at home" behind a proxy
# that is not on 127.0.0.1, e.g. Nginx Proxy Manager in Docker (172.16.0.0/12)
# or a proxy on another machine (its LAN IP).
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# "Keep me signed in" lifetime (sliding), and idle timeout otherwise.
# SESSION_REMEMBER_DAYS=365
# SESSION_SHORT_HOURS=12

# --- Playback ------------------------------------------------------------------

# raw = original file. Or a Navidrome transcoding format: mp3, opus, aac...
# STREAM_FORMAT=raw
# STREAM_MAX_BITRATE=0
# Used for files Cast cannot play (wma, ape, alac, >96 kHz...) and on playback errors.
# TRANSCODE_FALLBACK_FORMAT=mp3

# Report plays to Navidrome ("now playing", then scrobbles). Also in Settings.
# SCROBBLE=true

# Show the 5-star ratings in the interface, on every device. Also in Settings.
# SHOW_RATINGS=true

# Queue the next track on the Cast device ~20 s before the end of the current
# one, to shorten the gap between tracks. Set to false to disable.
# CAST_PRELOAD_NEXT=true

# Comma-separated Cast device IPs, if mDNS is blocked on your network.
# CAST_KNOWN_HOSTS=192.168.1.20,192.168.1.21

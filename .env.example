# --- Required ---------------------------------------------------------------

# Encrypts the stored Navidrome password. At least 32 characters; keep it
# stable (changing it forces a new sign-in). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string-of-48-chars

# Navidrome URL used by the CastHome backend.
NAVIDROME_URL=http://192.168.1.10:4533

# Navidrome URL used by the Cast devices to fetch audio and cover art.
# Must be reachable FROM the Chromecast: a LAN IP or a name your LAN DNS
# resolves. Never localhost or a Docker container name. Plain HTTP is fine;
# HTTPS needs a valid (not self-signed) certificate.
NAVIDROME_PUBLIC_URL_FOR_CAST=http://192.168.1.10:4533

# The Navidrome account CastHome plays with. Its password is asked on sign-in.
NAVIDROME_USERNAME=me

# --- Optional ---------------------------------------------------------------

# DATA_DIR=/data
# PORT=8080
# LOG_LEVEL=INFO

# Set to true when CastHome is served over HTTPS (adds the Secure cookie flag).
# COOKIE_SECURE=false

# "Keep me signed in" lifetime (sliding), and idle timeout otherwise.
# SESSION_REMEMBER_DAYS=365
# SESSION_SHORT_HOURS=12

# raw = original file. Or a Navidrome transcoding format: mp3, opus, aac...
# STREAM_FORMAT=raw
# STREAM_MAX_BITRATE=0
# Used for files Cast cannot play (wma, ape, alac, >96 kHz...) and on playback errors.
# TRANSCODE_FALLBACK_FORMAT=mp3

# Comma-separated Cast device IPs, if mDNS is blocked on your network.
# CAST_KNOWN_HOSTS=192.168.1.20,192.168.1.21
